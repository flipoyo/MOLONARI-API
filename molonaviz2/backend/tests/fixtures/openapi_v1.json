    "properties": {
     "data": {
      "items": {},
      "title": "Data",
      "type": "array"
     },
     "dtype": {
      "description": "numpy dtype: \"float64\", \"int64\", \"bool\", \"datetime64[s]\"…",
      "title": "Dtype",
      "type": "string"
     },
