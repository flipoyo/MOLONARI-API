     "code": {
      "description": "Stable code: E_… for an error, W_… for a warning.",
      "title": "Code",
      "type": "string"
     },
     "field": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Input field concerned, if any.",
      "title": "Field"
     },
     "message_en": {
      "description": "English message, formatted with params.",
      "title": "Message En",
      "type": "string"
     },
     "params": {
      "additionalProperties": true,
      "default": {},
      "description": "Parameters of the message template.",
      "title": "Params",
      "type": "object"
     }
    },
    "required": [
     "code",
     "message_en"
    ],
    "title": "ErrorOut",
    "type": "object"
   },
