      "type": "array"
     }
    },
    "required": [
     "dtype",
     "shape",
     "data"
    ],
    "title": "ArrayOut",
    "type": "object"
   },
   "ErrorOut": {
    "description": "Erreur attendue. Le client traduit à partir de `code` et de `params` ; `message_en` est le texte anglais.",
